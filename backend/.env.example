# =============================================================================
# CoachLink backend — application configuration.
#
#   cp backend/.env.example backend/.env
#
# NO REAL SECRET IS EVER COMMITTED. Every value below is a dev-only placeholder
# and matches the containers started by the repo-root `docker-compose.yml`.
# In staging/prod these come from Scaleway Secret Manager, not from a file.
#
# All variables are prefixed COACHLINK_ (see app/core/config.py, env_prefix).
# =============================================================================

# --- Runtime ---------------------------------------------------------------
COACHLINK_ENVIRONMENT=dev            # dev | test | staging | prod
COACHLINK_DEBUG=false
# OpenAPI (/docs, /openapi.json) is served in dev and test only — `front`
# generates the Dart models from it. It is never exposed in staging/prod.

# --- PostgreSQL 16 ---------------------------------------------------------
# TWO DISTINCT ROLES. This is a security control, not a convenience:
#   * coachlink_app   — what the API connects as. NOSUPERUSER, NOBYPASSRLS,
#                       owns no table. Row Level Security is a real barrier
#                       only under such a role.
#   * coachlink_owner — owns the schema, runs Alembic. Never used by the API.
# Provisioned by infra/postgres/init/01-roles.sql (dev) or
# backend/scripts/bootstrap_roles.sql (manual / staging).
COACHLINK_DATABASE_URL=postgresql+asyncpg://coachlink_app:coachlink_app_dev_only@localhost:5432/coachlink
COACHLINK_DATABASE_MIGRATION_URL=postgresql+asyncpg://coachlink_owner:coachlink_owner_dev_only@localhost:5432/coachlink
COACHLINK_DB_POOL_SIZE=10
COACHLINK_DB_MAX_OVERFLOW=5
COACHLINK_DB_ECHO=false

# --- Redis 7 ---------------------------------------------------------------
COACHLINK_REDIS_URL=redis://localhost:6379/0
COACHLINK_CELERY_BROKER_URL=redis://localhost:6379/1
COACHLINK_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ------------------------------------------------------------------
# Generate a real one with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
COACHLINK_JWT_SECRET=dev-only-not-a-real-secret-change-me
COACHLINK_JWT_ALGORITHM=HS256
COACHLINK_ACCESS_TOKEN_TTL_MINUTES=15
COACHLINK_REFRESH_TOKEN_TTL_DAYS=30
COACHLINK_ARGON2_TIME_COST=3
COACHLINK_ARGON2_MEMORY_COST_KIB=65536
COACHLINK_ARGON2_PARALLELISM=4

# --- Envelope encryption (GDPR, ARCHITECTURE.md §5.1) ----------------------
# Base64 of 32 random bytes — the KEK that wraps each user's DEK.
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# IN PRODUCTION THIS LIVES IN SCALEWAY SECRET MANAGER, NEVER IN A FILE.
# Losing it means losing every encrypted column; leaking it voids the whole
# at-rest protection.
COACHLINK_KEK_B64=ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLXBsYWNlaG9sZGVyISE=
COACHLINK_KEK_VERSION=1

# --- Object storage (MinIO in dev, Scaleway Object Storage Paris in prod) --
COACHLINK_S3_ENDPOINT_URL=http://localhost:9000
COACHLINK_S3_REGION=fr-par
COACHLINK_S3_BUCKET_MEDIA=coachlink-media
COACHLINK_S3_BUCKET_EXPORTS=coachlink-exports
COACHLINK_S3_ACCESS_KEY=coachlink_dev
COACHLINK_S3_SECRET_KEY=coachlink_dev_only
COACHLINK_S3_PRESIGN_TTL_SECONDS=300          # 5 min — media
COACHLINK_S3_EXPORT_PRESIGN_TTL_SECONDS=86400 # 24 h — GDPR export

# --- Media limits (ARCHITECTURE.md §6) -------------------------------------
COACHLINK_MAX_IMAGE_BYTES=5242880      # 5 MB
COACHLINK_MAX_VIDEO_BYTES=104857600    # 100 MB
COACHLINK_MAX_VIDEO_SECONDS=60

# --- Business rules --------------------------------------------------------
COACHLINK_CLIENT_TRIAL_DAYS=10
COACHLINK_INVITATION_TTL_HOURS=168     # 7 days
COACHLINK_ACCOUNT_DELETION_GRACE_DAYS=7
COACHLINK_INACTIVE_ACCOUNT_MONTHS=24
COACHLINK_MINIMUM_AGE_YEARS=16         # under-16 signup refused (§5.2)
COACHLINK_DEFAULT_TIMEZONE=Europe/Paris

# --- Rate limiting (ARCHITECTURE.md §8) ------------------------------------
COACHLINK_RATE_LIMIT_ENABLED=true
COACHLINK_RATE_LIMIT_PER_MINUTE=100
COACHLINK_LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Observability ---------------------------------------------------------
COACHLINK_LOG_LEVEL=INFO
COACHLINK_LOG_JSON=true
# Sentry must be self-hosted or in an EU region (§2.3). Empty = disabled.
COACHLINK_SENTRY_DSN=

# Comma-separated. Empty in prod: the mobile app is not a browser origin.
COACHLINK_CORS_ORIGINS=
