# =============================================================================
# CoachLink — variables de l'environnement de DEV LOCAL (docker-compose.yml).
#
# Copier en `.env` :  cp .env.example .env
# Le `.env` réel est gitignoré. Ce fichier-ci ne contient QUE des valeurs de dev
# factices — aucune valeur secrète réelle ne doit être committée, jamais.
#
# NB : la configuration applicative du backend vit dans `backend/.env.example`
# (maintenu par l'agent back). Ce fichier ne pilote que les conteneurs d'infra.
# =============================================================================

# --- PostgreSQL 16 ---
# DEUX rôles distincts (exigence Tech Lead, cf. infra/postgres/init/01-roles.sql) :
#  - owner : propriétaire du schéma, exécute les migrations Alembic
#  - app   : rôle de l'API, NOSUPERUSER + NOBYPASSRLS (ne peut PAS contourner la RLS)
POSTGRES_OWNER_USER=coachlink_owner
POSTGRES_OWNER_PASSWORD=coachlink_owner_dev_only
POSTGRES_APP_USER=coachlink_app
POSTGRES_APP_PASSWORD=coachlink_app_dev_only
POSTGRES_DB=coachlink
POSTGRES_PORT=5432

# --- Redis 7 (cache, Pub/Sub temps réel, broker Celery) ---
REDIS_PORT=6379

# --- MinIO (substitut local de Scaleway Object Storage Paris) ---
S3_ACCESS_KEY=coachlink_dev
S3_SECRET_KEY=coachlink_dev_only
S3_BUCKET_MEDIA=coachlink-media
S3_BUCKET_EXPORTS=coachlink-exports
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- URLs de connexion à donner au backend en dev ---
# DATABASE_URL=postgresql+asyncpg://coachlink:coachlink_dev_only@localhost:5432/coachlink
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=http://localhost:9000
